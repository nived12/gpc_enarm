<%# Modo ENARM: the real sitting's booklet and answer sheet. The booklet prints every
    question with its options as text, under its own "Pregunta N" heading; the answer
    sheet is a column of numbered rows of bubbles, one form per question, saved as each
    bubble is filled. Beside the booklet on a wide screen; on a phone it opens over the
    booklet, under the exam bar so the clock stays in sight, and closes back to where the
    student was reading. Without JavaScript it simply follows the booklet. %>
<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-10" data-controller="answer-sheet">
  <div data-answer-sheet-target="booklet">
    <% exam_questions.chunk_while { |a, b| a.clinical_case_id == b.clinical_case_id }.each do |group| %>
      <% clinical_case = group.first.clinical_case %>
      <section class="mt-12 border-t border-line pt-10 first-of-type:border-0 first-of-type:pt-0" lang="<%= clinical_case.locale %>">
        <% group.each_with_index do |exam_question, index| %>
          <article id="<%= dom_id(exam_question) %>" class="scroll-mt-44 <%= "mt-10 border-t border-line pt-8" unless index.zero? %>">
            <h2 class="text-xl font-semibold text-accent" lang="<%= I18n.locale %>"><%= t("exams.sheet.question_heading", number: exam_question.position) %></h2>
            <% if index.zero? %>
              <p class="vignette mt-4 text-ink"><%= clinical_case.stem %></p>
              <% if clinical_case.clinical_image&.file&.attached? %>
                <%= render "shared/figure", image: clinical_case.clinical_image, spacing: "mt-6" %>
              <% end %>
            <% end %>
            <p class="mt-6 text-base font-medium leading-relaxed text-ink"><%= exam_question.question.text %></p>
            <ol class="mt-4 space-y-2 text-sm leading-relaxed text-ink">
              <% exam_question.answer_options.each_with_index do |option, option_index| %>
                <li class="flex gap-3">
                  <span class="numeric w-4 shrink-0 font-medium text-ink-faint"><%= option_letter(option_index) %>.</span>
                  <span><%= option.text %></span>
                </li>
              <% end %>
            </ol>
          </article>
        <% end %>
      </section>
    <% end %>
  </div>

  <aside class="mt-12 lg:sticky lg:top-44 lg:mt-0 lg:max-h-[calc(100vh-12rem)] lg:self-start lg:overflow-y-auto lg:rounded-card lg:border lg:border-line lg:bg-surface lg:p-4"
         data-answer-sheet-target="panel" aria-labelledby="<%= dom_id(exam, :answer_sheet) %>">
    <div class="flex items-center justify-between gap-3">
      <h2 id="<%= dom_id(exam, :answer_sheet) %>" class="text-sm font-medium text-ink"><%= t("exams.booklet.answer_sheet") %></h2>
      <button type="button" class="hidden min-h-11 rounded-full border border-line-strong px-4 text-sm font-medium text-ink"
              data-answer-sheet-target="closer" data-action="answer-sheet#close"><%= t("exams.booklet.close_sheet") %></button>
    </div>
    <ol class="mt-3 divide-y divide-line">
      <% exam_questions.each do |exam_question| %>
        <li>
          <%= form_with url: exam_question_answer_path(exam, exam_question.position), method: :post,
                class: "flex items-center py-1",
                data: { controller: "autosave", action: "change->autosave#save" } do %>
            <fieldset class="flex items-center gap-1">
              <legend class="numeric float-left w-9 shrink-0 text-xs text-ink-muted">
                <a href="#<%= dom_id(exam_question) %>" class="inline-flex min-h-11 items-center hover:text-accent"
                   data-action="answer-sheet#close"><%= exam_question.position %></a>
              </legend>
              <% exam_question.answer_options.each_with_index do |option, option_index| %>
                <label class="relative inline-flex size-11 cursor-pointer items-center justify-center">
                  <%= radio_button_tag :answer_option_id, option.id, exam_question.answer&.answer_option_id == option.id,
                        id: dom_id(option, exam_question.id), class: "peer sr-only",
                        aria: { label: t("exams.booklet.bubble", number: exam_question.position, letter: option_letter(option_index)) } %>
                  <span class="numeric flex size-7 items-center justify-center rounded-full border border-line-strong text-xs text-ink-muted peer-checked:border-ink peer-checked:bg-ink peer-checked:text-ground peer-focus-visible:ring-2 peer-focus-visible:ring-accent" aria-hidden="true"><%= option_letter(option_index) %></span>
                </label>
              <% end %>
            </fieldset>
            <span id="<%= dom_id(exam_question, :saved) %>" class="sr-only" aria-live="polite"></span>
            <noscript><%= button_tag t("exams.sheet.save"), class: "btn btn--ghost" %></noscript>
          <% end %>
        </li>
      <% end %>
    </ol>
  </aside>

  <button type="button" class="btn btn--primary sticky bottom-4 z-30 mt-8 hidden w-full" data-answer-sheet-target="opener"
          data-action="answer-sheet#open">
    <%= t("exams.booklet.open_sheet") %>
  </button>
</div>
