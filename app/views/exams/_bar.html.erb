<%# The strip above every question: which exam, where in it, and the clock. The clock
    counts down on the timed modes and up on the others; both run from the server's
    figure, so a reload never gives time back. %>
<%# progress_label and progress say where the student is: "Pregunta 3 de 10" one question
    at a time, "12 de 280 respondidas" on the single page. %>
<div class="sticky top-[4.25rem] z-20 -mx-4 border-b border-line bg-ground/90 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6">
  <div class="flex items-center gap-3">
    <div class="min-w-0">
      <p class="eyebrow truncate"><%= t("exams.modes.#{exam.mode}") %></p>
      <p class="mt-0.5 whitespace-nowrap text-sm font-medium text-ink" id="<%= dom_id(exam, :progress_label) %>"><%= progress_label %></p>
    </div>

    <% if exam.status_in_progress? %>
      <div class="ml-auto flex items-center gap-2"
           data-controller="timer"
           data-timer-elapsed-value="<%= exam.current_elapsed %>"
           data-timer-limit-value="<%= exam.time_limit_seconds.to_i %>"
           data-timer-warn-at-value="<%= exam.final_warning_seconds.to_i %>"
           data-timer-warning-id-value="<%= dom_id(exam, :final_warning) %>">
        <span class="sr-only"><%= exam.time_limit_seconds ? t("exams.bar.time_left") : t("exams.bar.time_spent") %></span>
        <span class="numeric text-sm text-ink-muted" data-timer-target="display"><%= clock_reading(exam) %></span>
        <%= button_to t("exams.bar.pause"), pause_exam_path(exam), method: :patch,
              class: "min-h-11 rounded-full border border-line-strong px-4 text-sm font-medium text-ink hover:border-accent hover:text-accent" %>
        <% if exam.feedback_at_end? %>
          <%= button_to t("exams.bar.finish"), complete_exam_path(exam), method: :patch,
                form: { class: "hidden sm:block", data: { turbo_confirm: t("exams.sheet.confirm_finish") } },
                class: "min-h-11 rounded-full bg-accent px-4 text-sm font-medium text-accent-ink hover:bg-accent-hover" %>
        <% end %>
        <%= button_to t("exams.bar.finish"), complete_exam_path(exam), method: :patch,
              form: { hidden: true, data: { timer_target: "expire" } }, tabindex: -1 %>
      </div>
    <% else %>
      <%= link_to t("exams.bar.back_to_results"), exam_path(exam),
            class: "ml-auto inline-flex min-h-11 items-center text-sm text-accent underline underline-offset-2 hover:text-accent-hover" %>
    <% end %>
  </div>

  <div class="mt-3 h-1 overflow-hidden rounded-full bg-surface-sunk" aria-hidden="true">
    <%= render "exams/progress_fill", exam: exam, progress: progress %>
  </div>

  <%# Inside the strip, not over the page: the real sitting says it once and lets you work. %>
  <% if exam.status_in_progress? && exam.final_warning_seconds %>
    <p class="mt-3 text-sm font-medium text-accent" role="status" id="<%= dom_id(exam, :final_warning) %>"
       <%= "hidden" unless exam.remaining_seconds <= exam.final_warning_seconds %>>
      <%= t("exams.bar.final_warning") %>
    </p>
  <% end %>
</div>
