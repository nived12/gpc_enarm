<% content_for :title, t("exams.results.title") %>
<% answers = @exam.answers.index_by(&:exam_question_id) %>
<% correct = answers.values.count(&:correct?) %>

<section>
  <p class="eyebrow"><%= t("exams.modes.#{@exam.mode}") %> · <%= l(@exam.completed_at.to_date, format: :long) %></p>
  <h1 class="sr-only"><%= t("exams.results.title") %></h1>
  <%# A plain percentage, as CIFRHS reports it. Never weighted. %>
  <p class="numeric mt-4 text-5xl font-medium tracking-tight text-ink"><%= score_text(@exam.score) %></p>
  <p class="mt-2 text-sm text-ink-muted">
    <%= t("exams.results.tally", correct: correct, total: @exam.question_count) %>
    · <%= t("exams.results.time", time: clock(@exam.elapsed_seconds)) %>
  </p>
  <%# Time per question answered, against the real sitting's: finishing is part of the test. %>
  <% if answers.any? %>
    <p class="mt-1 text-sm text-ink-muted">
      <%= t("exams.results.pace", seconds: @exam.elapsed_seconds / answers.size, real: Exam::REAL_SECONDS_PER_QUESTION) %>
    </p>
  <% end %>
</section>

<% tally = @exam.tally_by_specialty %>
<% if tally.size > 1 %>
  <section class="mt-10">
    <h2 class="eyebrow"><%= t("exams.results.by_specialty") %></h2>
    <% if tally.sum { |_specialty, _right, asked| asked } > @exam.question_count %>
      <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink-muted"><%= t("exams.results.by_specialty_overlap") %></p>
    <% end %>
    <ul class="mt-3 divide-y divide-line border-y border-line">
      <% tally.each do |specialty, right, asked| %>
        <li class="flex items-baseline justify-between gap-4 py-3 text-sm">
          <span class="text-ink"><%= specialty.name %></span>
          <span class="numeric text-ink-muted"><%= t("exams.results.specialty_tally", correct: right, total: asked) %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= render "remediation/report", exam: @exam %>

<section class="mt-10">
  <h2 class="eyebrow"><%= t("exams.results.questions") %></h2>
  <ol class="mt-3 space-y-2">
    <% @exam.exam_questions.includes(:question).each do |exam_question| %>
      <% answer = answers[exam_question.id] %>
      <li>
        <%= link_to exam_question_path(@exam, exam_question.position),
              class: "card flex items-start gap-4 px-5 py-4 text-sm transition-shadow hover:ring-2 hover:ring-accent" do %>
          <span class="numeric w-6 shrink-0 text-ink-faint"><%= exam_question.position %></span>
          <span class="min-w-0 flex-1 leading-relaxed text-ink"><%= exam_question.question.text.truncate(140) %></span>
          <span class="flex shrink-0 flex-col items-end gap-1 text-xs font-medium">
            <span class="<%= answer&.correct? ? "text-correct" : answer ? "text-incorrect" : "text-ink-faint" %>">
              <%= if answer.nil? then t("exams.results.blank")
                  elsif answer.correct? then "✓ #{t("exams.results.right")}"
                  else "✗ #{t("exams.results.wrong")}" end %>
            </span>
            <% if answer&.confidence %>
              <span class="inline-flex items-center gap-1 <%= answer.confidence_sure? && !answer.correct? ? "text-incorrect" : "text-ink-faint" %>"
                    title="<%= t("exams.confidence.levels.#{answer.confidence}") %>">
                <%= render "exam_questions/confidence_icon", level: answer.confidence, size: "size-4" %>
                <span class="sr-only"><%= t("exams.confidence.levels.#{answer.confidence}") %></span>
              </span>
            <% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>

<div class="mt-10 flex flex-col gap-3 sm:flex-row">
  <%= link_to t("exams.results.new_exam"), new_exam_path, class: "btn btn--primary" %>
  <%= link_to t("exams.results.history"), exams_path, class: "btn btn--ghost" %>
</div>

<div class="mt-6"><%= render "exams/discard", exam: @exam %></div>
