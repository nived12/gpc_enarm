<nav class="flex items-center justify-between gap-4 text-sm">
  <%= link_to t("review.show.back"), review_clinical_cases_path(filters), class: "text-ink-muted hover:text-accent" %>
  <span class="text-ink-faint"><%= t("review.show.position", position: @position, total: @total) %></span>
</nav>

<%# The case: what it is about, then the vignette, with nothing competing between them. %>
<section class="mt-10">
  <h1 class="text-xl font-semibold tracking-tight text-ink">
    <%= @case.topic&.name || @case.guideline&.title %>
  </h1>

  <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-faint">
    <span><%= t("difficulties.#{@case.difficulty}") %></span>
    <% if @case.guideline %>
      <span aria-hidden="true">·</span>
      <span><%= @case.guideline.catalog_key %></span>
      <span aria-hidden="true">·</span>
      <span><%= @case.guideline.year || t("review.show.undated") %></span>
    <% end %>
  </p>

  <%# Shown on the case rather than per question: a reviewer needs to know the guideline
      is past its validity before reading the vignette, not after. %>
  <% if @case.guideline&.expired? %>
    <p class="mt-6 rounded-card border border-incorrect bg-incorrect-soft px-4 py-3 text-sm text-incorrect">
      <%= t("review.show.expired_warning") %>
    </p>
  <% end %>

  <% if @case.status_retired? %>
    <p class="mt-6 rounded-card border border-line-strong px-4 py-3 text-sm text-ink"><%= t("review.show.retired_notice") %></p>
  <% end %>
  <%= render "admin/clinical_cases/review_panel", clinical_case: @case, open_reports: @open_reports %>

  <%# Before the vignette, so a reviewer knows what the second model found before reading
      — its notes name the question they are about. %>
  <% verdict = verdict_of(@case) %>
  <div class="mt-6 rounded-card border px-5 py-4 text-sm <%= verdict_classes(verdict) %>">
    <p class="flex flex-wrap items-baseline gap-x-2">
      <span class="eyebrow"><%= t("review.show.second_opinion") %></span>
      <span class="font-medium"><%= t("review.verdicts.#{verdict}") %></span>
    </p>
    <p class="mt-2 leading-relaxed text-ink-muted"><%= t("review.show.verdict_meaning.#{verdict}") %></p>
    <% if @case.verification_notes.present? %>
      <ul class="mt-3 space-y-2 leading-relaxed text-ink">
        <% @case.verification_notes.lines.map(&:strip).compact_blank.each do |note| %>
          <li><%= note %></li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%# Serif and roomy: the vignette is the one thing on screen that is not interface, and
      it is what she is actually being asked to judge. %>
  <p class="vignette mt-8 font-serif text-lg leading-loose text-ink"><%= @case.stem %></p>

  <%# An image that belongs to the question — a film or a tracing to interpret — under the
      vignette, in the order the exam asks for: read the patient, then look at the image.
      A guideline's own figures never go here; they appear with the cited recommendation,
      after the answer, because they carry it. The attribution is a licence condition, so
      it is rendered from the row rather than assembled here. %>
  <% if @case.clinical_image&.file&.attached? %>
    <%= render "shared/figure", image: @case.clinical_image, spacing: "mt-8" %>
  <% end %>
</section>

<% @case.questions.each_with_index do |question, index| %>
  <%# Each question is a block with its own label and a wide gap before it, so two
      questions about the same case never read as one run-on wall of text. %>
  <article class="mt-16">
    <p class="eyebrow"><%= t("review.show.question_label", number: index + 1) %></p>
    <h2 class="mt-3 text-base font-medium leading-relaxed text-ink"><%= question.text %></h2>

    <ul class="mt-6 space-y-3">
      <% question.answer_options.each do |option| %>
        <%# Correct and incorrect must never rely on hue alone — roughly 8% of her male
            colleagues are colour-blind, and this is the one screen where misreading a
            colour costs real learning. The mark carries the meaning; colour agrees. %>
        <li class="flex items-start gap-4 rounded-card border px-5 py-4 text-sm leading-relaxed <%= option.correct? ? "border-correct bg-correct-soft" : "border-line" %>">
          <span class="mt-px w-4 shrink-0 text-center font-medium <%= option.correct? ? "text-correct" : "text-ink-faint" %>">
            <%= option.correct? ? "✓" : "·" %>
          </span>
          <span class="min-w-0">
            <span class="text-ink"><%= option.text %></span>
            <%# What a student who chose it will read, and what the second opinion made of
                it. A rejected rationale is shown here, struck through with the reason, so
                the doctor can judge the judge; students never see it. %>
            <% if option.rationale.present? && !option.correct? %>
              <span class="mt-2 block text-xs leading-relaxed <%= option.rationale_rejected? ? "text-ink-faint line-through" : "text-ink-muted" %>"><%= option.rationale %></span>
              <% rationale_verdict = option.rationale_verdict || "unjudged" %>
              <span class="mt-1 block text-xs <%= option.rationale_rejected? ? "text-incorrect" : "text-ink-faint" %>">
                <%= t("review.show.rationale_verdicts.#{rationale_verdict}") %><% if option.rationale_note.present? %>: <%= option.rationale_note %><% end %>
              </span>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>

    <% if question.explanation.present? %>
      <p class="mt-6 leading-relaxed text-ink-muted"><%= question.explanation %></p>
    <% end %>

    <% if question.recommendation %>
      <div class="mt-6 rounded-card bg-surface-sunk px-6 py-5">
        <p class="eyebrow"><%= t("review.show.source") %></p>

        <%# The quoted span is marked inside the full recommendation, so a reviewer can see
            at a glance whether the question used it fairly or lifted it out of context. %>
        <p class="vignette mt-4 text-sm leading-loose text-ink">
          <%= highlighted(question.recommendation.readable_text, question.recommendation.readable_quote(question.source_quote)) %>
        </p>

        <%# The figure the statement points at, as the student will meet it: part of the
            explanation, once the question is answered. %>
        <% if (figure = question.recommendation.figure) %>
          <%= render "shared/figure", image: figure, spacing: "mt-5" %>
        <% end %>

        <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-ink-faint">
          <span><%= question.citation %></span>
          <% if @case.guideline&.source_url.present? %>
            <%# The live site loads sections by AJAX — no href, no anchor, no URL of their
                own — so a link can only open the guideline at its first section, which
                looks like a landing page. Naming the section is the best available
                signpost: the site's own menu lists them under exactly these headings. %>
            <%= link_to t("review.show.open_guideline"), @case.guideline.source_url,
                  target: "_blank", rel: "noopener",
                  class: "text-accent underline underline-offset-2 hover:text-accent-hover" %>
            <span class="text-ink-faint"><%= question.recommendation.guideline_section.menu_path %></span>
          <% end %>
        </p>
      </div>
    <% end %>
  </article>
<% end %>

<nav class="mt-20 flex items-center justify-between gap-4 border-t border-line pt-8">
  <% if @previous %>
    <%= link_to t("review.show.previous"), review_clinical_case_path(@previous, filters),
          class: "inline-flex min-h-11 items-center rounded-full border border-line px-5 text-sm text-ink hover:border-accent" %>
  <% else %>
    <span></span>
  <% end %>

  <%# The point of this screen is reading through a batch, so the next case is one tap
      away rather than a trip back to the list. %>
  <% if @next %>
    <%= link_to t("review.show.next"), review_clinical_case_path(@next, filters),
          class: "inline-flex min-h-11 items-center rounded-full bg-accent px-5 text-sm font-medium text-accent-ink hover:bg-accent-hover" %>
  <% else %>
    <span></span>
  <% end %>
</nav>
